# Postgres connection. On Render this is provided automatically when the
# database is linked in render.yaml. For local development, point it at a
# local or hosted Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/business_assistant

# Set to "production" on Render (enables SSL for the DB connection).
NODE_ENV=development

# Secret used to sign JWTs. Generate a long random string for real use.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:8790,https://bidyutsethi.github.io

PORT=4000
