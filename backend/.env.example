# Postgres connection. On Render this is provided automatically when the
# database is linked in render.yaml. For local development, point it at a
# local or hosted Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/business_assistant

# Set to "production" on Render (enables SSL for the DB connection).
NODE_ENV=development

# Secret used to sign JWTs. Generate a long random string for real use.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:8790,https://bidyutsethi.github.io

# Secret required (as an X-Seed-Key header) to call POST /api/admin/seed.
# Lets sample data be (re)seeded without Shell access. Leave unset to
# disable the endpoint entirely.
ADMIN_SEED_KEY=change-this-to-a-long-random-string

# Email of the account that runs this site (comma-separate several). That
# account sees the Demo Requests inbox and is made an admin of its workspace.
# If unset, an admin of the oldest workspace is treated as the owner.
OWNER_EMAIL=you@example.com

PORT=4000
